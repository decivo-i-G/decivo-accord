{
  "name": "decivo-accord",
  "private": true,
  "description": "Das Register für Design-Entscheidungen, gegen das Menschen und Agenten prüfen.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.14.4",
