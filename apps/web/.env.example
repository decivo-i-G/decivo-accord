# Lokale Entwicklung: Repositories, die die App zeigt (JSON). Pfade relativ zu apps/web;
# "register" ist optional (Standard: <root>/.accord, angelegt mit `accord init`).
ACCORD_PROJECTS=[{"slug":"demo","name":"acme/demo","root":"../../examples/demo/project"}]

# Datenbank (Supabase Postgres, Region EU)
DATABASE_URL=

# Anmeldung mit GitHub (better-auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
