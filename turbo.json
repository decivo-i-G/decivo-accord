{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {},
    "test": {
      "outputs": []
    },
    "@decivo/accord-ui#build": {
      "dependsOn": ["^build", "@decivo/accord-web#build"],
      "outputs": ["dist/**", "app/**"]
    }
  }
}
