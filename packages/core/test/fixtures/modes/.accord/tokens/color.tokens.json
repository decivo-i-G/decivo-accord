{
  "color": {
    "$type": "color",
    "neutral": {
      "50": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9804,
            0.9804,
            0.9804
          ],
          "hex": "#fafafa"
        }
      },
      "900": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0902,
            0.0902,
            0.0902
          ],
          "hex": "#171717"
        }
      },
      "950": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0392,
            0.0392,
            0.0392
          ],
          "hex": "#0a0a0a"
        }
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0392,
          0.0392,
          0.0392
        ],
        "hex": "#0a0a0a"
      }
    },
    "primary": {
      "$value": "{color.neutral.900}"
    },
    "primary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9804,
          0.9804,
          0.9804
        ],
        "hex": "#fafafa"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "hex": "#f5f5f5"
      }
    },
    "muted-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.451,
          0.451,
          0.451
        ],
        "hex": "#737373"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.898,
          0.898,
          0.898
        ],
        "hex": "#e5e5e5"
      }
    },
    "text": {
      "$value": "{color.foreground}",
      "$description": "Body text"
    }
  },
  "radius": {
    "$type": "dimension",
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  }
}
