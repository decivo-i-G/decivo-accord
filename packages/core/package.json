{
  "name": "@decivo/accord-core",
  "version": "0.1.0",
  "description": "Register schema, DTCG 2025.10, ownership model and three-way diff for decivo Accord.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decivo-i-G/decivo-accord.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/decivo-i-G/decivo-accord#readme",
  "bugs": "https://github.com/decivo-i-G/decivo-accord/issues",
  "keywords": [
    "design-tokens",
    "design-system",
    "dtcg",
    "figma",
    "governance",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "@decivo/accord-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@decivo/accord-source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "culori": "4.0.2",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/culori": "4.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
